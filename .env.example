# ===========================================================================
# AMM INNOV — variables d'environnement
#   cp .env.example .env
# Les valeurs ci-dessous conviennent au développement local (docker compose).
# En production, remplacer TOUTES les valeurs marquées « CHANGER ».
# ===========================================================================

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------
# Clé secrète : générer avec
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# CHANGER en prod
DJANGO_SECRET_KEY=dev-only-change-me-please-0123456789abcdef
# 1 en développement, 0 en production
DJANGO_DEBUG=1
# config.settings.dev | config.settings.prod (config.settings.test pour pytest)
DJANGO_SETTINGS_MODULE=config.settings.dev
# Hôtes autorisés (séparés par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1,backend
# Origines CORS autorisées (le frontend Vite en dev)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# URL publique du frontend, utilisée dans les emails (liens vers les AMM)
FRONTEND_URL=http://localhost:5173
# Fuseau des traitements planifiés (recalcul des statuts à 00:05, digest le lundi 08:00)
TIME_ZONE=Africa/Dakar
# Version déployée, exposée par /api/v1/health et affichée dans la barre du haut (tag ou sha court).
# Lettres, chiffres et . _ + - ; 64 caractères au plus. Vide ou non conforme : « dev ».
APP_VERSION=

# ---------------------------------------------------------------------------
# Base de données PostgreSQL
# ---------------------------------------------------------------------------
POSTGRES_USER=amm
# CHANGER en prod
POSTGRES_PASSWORD=amm
POSTGRES_DB=amm
# URL utilisée par Django (hôte = nom du service compose)
# CHANGER en prod (même mot de passe)
DATABASE_URL=postgres://amm:amm@postgres:5432/amm
# Mot de passe du rôle Postgres `grafana_ro` (créé par une migration du backend,
# lecture seule sur le schéma analytics). Grafana l'utilise via le provisioning.
# CHANGER en prod
GRAFANA_DB_PASSWORD=grafana_ro

# ---------------------------------------------------------------------------
# Redis (channel layer Channels + broker/backend Celery)
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
# Délais des appels Redis (secondes). Redis ne sert qu'au temps réel, au throttle de connexion et
# à la file des tâches : ses appels doivent échouer vite (docs/audit-resilience).
REDIS_CONNECT_TIMEOUT=1
REDIS_SOCKET_TIMEOUT=1

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Dev : Mailpit capture tout (interface http://localhost:8025).
# Prod : smtp+tls://utilisateur:motdepasse@smtp.fournisseur.tld:587  (STARTTLS, port 587)
#        smtps://utilisateur:motdepasse@smtp.fournisseur.tld:465     (TLS direct)
# Gmail : les hébergeurs qui bloquent les ports SMTP sortants (Railway) imposent l'API Gmail.
#         EMAIL_URL=gmail:// et les trois variables ci-dessous (scripts/gmail_oauth.py).
#         DEFAULT_FROM_EMAIL doit porter l'adresse du compte, sinon Gmail réécrit l'expéditeur.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
EMAIL_URL=smtp://mailpit:1025
DEFAULT_FROM_EMAIL=AMM INNOV <no-reply@amm.local>

# ---------------------------------------------------------------------------
# Alertes
# ---------------------------------------------------------------------------
# Une alerte dont l'échéance est plus ancienne que N jours est créée sans notification
# (protection contre le déluge d'emails au premier lancement sur l'historique).
# Voir aussi : python manage.py evaluate_alerts --quiet
ALERTS_DISPATCH_MAX_AGE_DAYS=30

# ---------------------------------------------------------------------------
# Sécurité / exploitation
# ---------------------------------------------------------------------------
# Nombre de proxys devant Django (Railway, Caddy, nginx = 1) : la vraie IP cliente est lue dans
# X-Forwarded-For pour le throttle de connexion. 0 = aucun proxy (dev).
NUM_PROXIES=0
# Jeton exigé sur /metrics (Authorization: Bearer …). Vide = endpoint public (réseau interne).
METRICS_TOKEN=
# Pool de connexions PostgreSQL par processus (web : 20 suffisent pour ~60 utilisateurs actifs ;
# chaque processus Celery a le sien). DB_POOL=0 pour désactiver.
DB_POOL=1
DB_POOL_MAX_SIZE=20
DB_POOL_TIMEOUT=10
# Délais PostgreSQL : connexion (s), requête, attente de verrou, transaction abandonnée (ms).
# Relever DB_STATEMENT_TIMEOUT_MS sur le worker si un traitement de masse le demande.
DB_CONNECT_TIMEOUT=5
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=10000
DB_IDLE_TX_TIMEOUT_MS=60000
# Cookie httpOnly du refresh token (chemin /api/v1/auth). Domaine commun frontend/API en prod,
# ex. AUTH_REFRESH_COOKIE_DOMAIN=.amm-innov.com ; SameSite=None seulement entre deux domaines
# sans lien (bloqué par Safari). Secure = automatique hors DEBUG.
AUTH_REFRESH_COOKIE_DOMAIN=
AUTH_REFRESH_COOKIE_SAMESITE=Lax
# Processus web uvicorn (~80 req/s par processus). Chaque processus a son pool PostgreSQL :
# N × DB_POOL_MAX_SIZE (+ worker Celery) doit rester sous max_connections.
WEB_CONCURRENCY=1
# Arrêt (SIGTERM) : délai laissé aux requêtes en cours avant la sortie du processus (s)
GRACEFUL_TIMEOUT=20
# Journaux : json (production, défaut hors DEBUG) ou text
LOG_FORMAT=text

# ---------------------------------------------------------------------------
# Documents (scans PDF)
# ---------------------------------------------------------------------------
# Taille maximale d'un fichier téléversé (Mo)
DOCUMENT_MAX_MB=25
# Stockage : local (volume Docker `media`) ou s3 (MinIO / S3 compatible).
DOCUMENT_STORAGE=local
# --- Paramètres S3, utilisés si DOCUMENT_STORAGE=s3 (profil compose `s3`, ou R2/B2/S3 en prod) ---
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_BUCKET=amm-documents
S3_REGION=auto
AWS_S3_REGION_NAME=us-east-1
# Identifiants de l'instance MinIO (services minio / minio-init)
MINIO_ROOT_USER=minio
# CHANGER en prod
MINIO_ROOT_PASSWORD=minio12345
S3_BUCKET=amm-documents

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
# CHANGER en prod
GRAFANA_ADMIN_PASSWORD=admin
# Dev : Grafana est servi directement sur http://localhost:3000/.
# Prod : docker-compose.prod.yml force le sous-chemin https://<DOMAIN>/grafana/.
GRAFANA_ROOT_URL=http://localhost:3000/
GRAFANA_SERVE_FROM_SUB_PATH=false

# ---------------------------------------------------------------------------
# Production (docker-compose.prod.yml)
# ---------------------------------------------------------------------------
# Nom de domaine public servi par Caddy (certificat Let's Encrypt automatique).
# Pour un test sans domaine : DOMAIN=:80
# CHANGER en prod
DOMAIN=amm.example.com
# CHANGER en prod
ACME_EMAIL=admin@example.com
# Tag des images GHCR à déployer (sha du commit ou latest)
TAG=latest
# Nombre de processus Celery
CELERY_CONCURRENCY=2
# Sauvegardes : heure de lancement (Africa/Dakar) et rétention en jours
BACKUP_HOUR=02
BACKUP_RETENTION_DAYS=30

# ---------------------------------------------------------------------------
# Ports publiés sur la machine hôte (dev uniquement)
# ---------------------------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=5173
GRAFANA_PORT=3000
POSTGRES_PORT=5432
REDIS_PORT=6379
MAILPIT_HTTP_PORT=8025
MAILPIT_SMTP_PORT=1025
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
PROMETHEUS_PORT=9090

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------
# Base de l'API vue du navigateur (chemin relatif : le proxy Vite / nginx route /api)
VITE_API_BASE=
# Cible du proxy Vite en dev Docker (les requêtes /api et /ws sont relayées ici)
VITE_PROXY_TARGET=http://backend:8000

# Version de l'image Grafana (11.6.0 par défaut)
GRAFANA_VERSION=12.1.1
# Version de Node pour les images frontend
NODE_VERSION=24
# Style d'adressage S3 : path (MinIO, R2) ou virtual (AWS S3)
S3_ADDRESSING_STYLE=path
# Délais S3 (s) : sans eux, boto attend 60 s par appel et relance (docs/audit-resilience)
S3_CONNECT_TIMEOUT=3
S3_READ_TIMEOUT=10
