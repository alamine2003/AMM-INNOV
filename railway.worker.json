{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "docker/backend.Dockerfile"
  },
  "deploy": {
    "startCommand": "/usr/local/bin/entrypoint.sh celery -A config worker -l info --concurrency 2 -B --scheduler django_celery_beat.schedulers:DatabaseScheduler",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5,
    "numReplicas": 1
  }
}
