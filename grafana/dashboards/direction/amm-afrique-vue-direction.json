      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "amm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT status AS \"Statut\", count(*)::int AS \"AMM\" FROM analytics.v_amm_current WHERE country_iso2 IN (${country:sqlstring}) GROUP BY status ORDER BY 2 DESC",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "VALIDE"
