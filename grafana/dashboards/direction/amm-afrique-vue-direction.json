    {
      "id": 11,
      "type": "table",
      "title": "AMM par pays — reprise du classeur Excel",
      "description": "Une ligne par pays plus une ligne TOTAL, mêmes colonnes que l'onglet DASHBOARD du classeur. Seuils : % valides rouge < 60, orange 60–80, vert ≥ 80.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "amm-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "amm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT country_name AS \"Pays\",\n       country_iso2 AS \"ISO\",\n       total        AS \"Total AMM\",\n       valid        AS \"Valides\",\n       expired      AS \"Expirées\",\n       in_process   AS \"En cours\",\n       undetermined AS \"Indéterminées\",\n       pct_valid    AS \"% valides\",\n       expiring_6m  AS \"Expirant < 6 mois\",\n       expiring_12m AS \"Expirant < 12 mois\",\n       pct_complete AS \"% dossiers complets\"\nFROM analytics.mv_country_kpi\nWHERE country_iso2 IN (${country:sqlstring})\nUNION ALL\nSELECT 'TOTAL', '', sum(total), sum(valid), sum(expired), sum(in_process), sum(undetermined),\n       round(100.0*sum(valid)/nullif(sum(total),0),1),\n       sum(expiring_6m), sum(expiring_12m),\n       round(sum(pct_complete*total)/nullif(sum(total),0),1)\nFROM analytics.mv_country_kpi\nWHERE country_iso2 IN (${country:sqlstring})\nORDER BY (\"Pays\" = 'TOTAL'), \"Pays\"",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
