      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "amm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT q.country_iso2 AS \"Pays\", k.total AS \"Total AMM\",\n       q.undetermined AS \"Indéterminées\", q.incomplete AS \"Dossiers incomplets\", q.missing_scan AS \"Sans scan\",\n       round(100.0*q.undetermined/nullif(k.total,0),1) AS \"% indéterminées\",\n       k.pct_complete AS \"% dossiers complets\"\nFROM analytics.v_data_quality q\nLEFT JOIN analytics.mv_country_kpi k USING (country_iso2)\nWHERE q.country_iso2 IN (${country:sqlstring})\nUNION ALL\nSELECT 'TOTAL', sum(k.total), sum(q.undetermined), sum(q.incomplete), sum(q.missing_scan),\n       round(100.0*sum(q.undetermined)/nullif(sum(k.total),0),1),\n       round(sum(k.pct_complete*k.total)/nullif(sum(k.total),0),1)\nFROM analytics.v_data_quality q\nLEFT JOIN analytics.mv_country_kpi k USING (country_iso2)\nWHERE q.country_iso2 IN (${country:sqlstring})\nORDER BY (\"Pays\" = 'TOTAL'), \"Pays\"",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
