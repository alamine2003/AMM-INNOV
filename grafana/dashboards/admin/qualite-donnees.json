      "id": 9,
      "type": "table",
      "title": "Qualité des données par pays (v_data_quality)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "amm-postgres"
      },
      "gridPos": {
