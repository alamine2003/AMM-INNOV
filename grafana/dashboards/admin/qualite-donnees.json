    {
      "id": 12,
      "type": "table",
      "title": "AMM au statut INDETERMINE (date illisible ou absente)",
      "description": "À ressaisir dans l'application : date de début ou numéro d'AMM manquant/illisible.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "amm-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "amm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT country_iso2 AS \"Pays\", product_name AS \"Produit\", range_code AS \"Gamme\",\n       original_number AS \"N° AMM\", status AS \"Statut\", urgency AS \"Urgence\", effective_end_date AS \"Date de fin\",\n       dossier_state AS \"Dossier\", has_current_scan AS \"Scan\"  FROM analytics.v_amm_current WHERE country_iso2 IN (${country:sqlstring}) AND status='INDETERMINE' ORDER BY country_iso2, product_name",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Statut"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "VALIDE": {
                        "color": "green",
                        "index": 0,
                        "text": "VALIDE"
                      },
                      "EXPIRE": {
                        "color": "red",
                        "index": 1,
                        "text": "EXPIRE"
                      },
