    {
      "id": 9,
      "type": "barchart",
      "title": "Entonnoir des renouvellements par statut de workflow",
      "description": "PLANIFIE → EN_PREPARATION → DEPOSE → EN_INSTRUCTION → OBTENU | REJETE | ABANDONNE",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "amm-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "amm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT workflow_status AS \"Statut\", coalesce(sum(count),0)::int AS \"Renouvellements\"\nFROM analytics.v_renewal_funnel WHERE country_iso2 IN (${country:sqlstring}) GROUP BY workflow_status ORDER BY CASE workflow_status WHEN 'PLANIFIE' THEN 1 WHEN 'EN_PREPARATION' THEN 2 WHEN 'DEPOSE' THEN 3 WHEN 'EN_INSTRUCTION' THEN 4 WHEN 'OBTENU' THEN 5 WHEN 'REJETE' THEN 6 WHEN 'ABANDONNE' THEN 7 ELSE 99 END",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 85,
            "gradientMode": "none",
            "axisPlacement": "auto",
            "axisLabel": "",
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "scaleDistribution": {
              "type": "linear"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Renouvellements"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "horizontal",
        "stacking": "normal",
        "showValue": "auto",
        "groupWidth": 0.7,
        "barWidth": 0.9,
        "barRadius": 0,
        "fullHighlight": false,
        "xTickLabelRotation": -30,
        "xTickLabelSpacing": 0,
        "legend": {
          "displayMode": "hidden",
          "placement": "bottom",
          "showLegend": false,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
