        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "amm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT country_iso2 AS \"Pays\",\n       coalesce(sum(count) FILTER (WHERE workflow_status='OBTENU'),0)::int AS \"Obtenus\",\n       coalesce(sum(count) FILTER (WHERE workflow_status='REJETE'),0)::int AS \"Rejetés\",\n       round((sum(avg_days_to_decision*count) FILTER (WHERE workflow_status IN ('OBTENU','REJETE'))\n              / nullif(sum(count) FILTER (WHERE workflow_status IN ('OBTENU','REJETE')),0))::numeric, 0) AS \"Délai moyen (j)\"\nFROM analytics.v_renewal_funnel WHERE country_iso2 IN (${country:sqlstring}) GROUP BY 1 ORDER BY 4 DESC NULLS LAST",
          "refId": "A"
        }
