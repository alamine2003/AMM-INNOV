    {
      "id": 11,
      "type": "table",
      "title": "Délai moyen de décision par pays (jours)",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "amm-postgres"
      },
      "gridPos": {
        "x": 0,
