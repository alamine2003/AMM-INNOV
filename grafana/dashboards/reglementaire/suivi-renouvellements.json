            "uid": "amm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT round((sum(avg_days_to_decision*count)/nullif(sum(count),0))::numeric, 0) AS \"Jours\"\nFROM analytics.v_renewal_funnel WHERE country_iso2 IN (${country:sqlstring}) AND workflow_status IN ('OBTENU','REJETE') AND avg_days_to_decision IS NOT NULL",
