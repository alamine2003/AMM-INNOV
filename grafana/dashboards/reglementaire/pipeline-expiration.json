    {
      "id": 9,
      "type": "timeseries",
      "title": "AMM arrivant à expiration par mois et par pays",
      "description": "Nombre d'AMM dont la date de fin effective tombe dans le mois (analytics.mv_expiry_pipeline). La plage de temps du dashboard couvre les 24 prochains mois.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "amm-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 11
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "amm-postgres"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT month AS time, country_iso2 AS metric, count::float AS value\nFROM analytics.mv_expiry_pipeline\nWHERE country_iso2 IN (${country:sqlstring})\n  AND month >= date_trunc('month', now()) - interval '1 month'\n  AND month <  date_trunc('month', now()) + interval '24 months'\nORDER BY 1, 2",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 80,
            "gradientMode": "none",
            "showPoints": "never",
            "pointSize": 4,
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisLabel": "",
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "barAlignment": 0,
            "insertNulls": false,
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "barchart",
      "title": "Niveaux d'urgence par pays",
      "description": "",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "amm-postgres"
      },
