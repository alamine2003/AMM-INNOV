    {
      "id": 12,
      "type": "table",
      "title": "50 prochaines échéances",
      "description": "AMM non expirées triées par date de fin effective croissante.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "amm-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 27,
        "w": 24,
        "h": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "amm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT country_iso2 AS \"Pays\", product_name AS \"Produit\", range_code AS \"Gamme\",\n       original_number AS \"N° AMM\", status AS \"Statut\", urgency AS \"Urgence\",\n       effective_end_date AS \"Date de fin\", filing_deadline AS \"Deadline dépôt\",\n       days_remaining AS \"Jours restants\", dossier_state AS \"Dossier\", has_current_scan AS \"Scan\" \nFROM analytics.v_amm_current\nWHERE country_iso2 IN (${country:sqlstring}) AND effective_end_date >= current_date\nORDER BY effective_end_date ASC\nLIMIT 50",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": true
          },
