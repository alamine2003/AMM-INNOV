            "type": "grafana-postgresql-datasource",
            "uid": "amm-postgres"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT country_iso2 AS \"Pays\",\n       count(*) FILTER (WHERE urgency='CRITIQUE')::int       AS \"CRITIQUE\",\n       count(*) FILTER (WHERE urgency='DEPOT_URGENT')::int   AS \"DEPOT_URGENT\",\n       count(*) FILTER (WHERE urgency='A_PLANIFIER')::int    AS \"A_PLANIFIER\",\n       count(*) FILTER (WHERE urgency='EN_INSTRUCTION')::int AS \"EN_INSTRUCTION\",\n       count(*) FILTER (WHERE urgency='EXPIRE')::int         AS \"EXPIRE\",\n       count(*) FILTER (WHERE urgency='OK')::int             AS \"OK\"\nFROM analytics.v_amm_current WHERE country_iso2 IN (${country:sqlstring}) GROUP BY 1 ORDER BY 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
